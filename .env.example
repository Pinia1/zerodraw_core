# API 服务器配置
PORT=3070
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# SQLite 数据库（单机版默认，无需 MySQL）
DATABASE_URL=file:./data/app.db

# JWT 配置
JWT_SECRET=change-me-in-production

# Agent 对话模型（ARK 火山方舟 /api/plan 网关）
AGENT_MODEL=ark-code-latest
AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
AGENT_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx

# Agent Admin 观测台（可选）
# AGENT_ADMIN_TOKEN=

# 本地文件上传目录（默认 ./data/uploads）
# LOCAL_UPLOAD_DIR=./data/uploads
# UPLOAD_PROVIDER=local

# 可选：GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 可选：Redis（未配置则 runtime 快照走进程内内存）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# 可选：火山 TOS 云存储
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=
# UPLOAD_PROVIDER=volc

# 可选：Cloudflare R2（UPLOAD_PROVIDER=r2 时启用）
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://cdn.example.com

# 前端
VITE_API_URL=http://localhost:3070
VITE_IMAGE_THUMBNAIL=/api/file/thumbnail
VITE_IMAGE_FILE=/api/file/s3
# VITE_R2_URL=
# VITE_R2_THUMBNAIL_URL=
